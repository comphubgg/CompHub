{
  "name": "streamer-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-3000.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "refresh-rankings": "python scripts/refresh_rankings.py --top 10000 --headless",
    "refresh-rankings-live": "python scripts/refresh_rankings.py --top 10000 --headless --live-upload",
    "epic-login": "node scripts/epic-login.js",
    "schnell": "next build && next start -H 0.0.0.0",
    "exe": "node elektron/bauen.mjs",
    "exe-klein": "node elektron/bauen.mjs --ohne-daten"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "electron-updater": "^6.8.9",
    "fortnite-replay-parser": "^1.4.8",
    "fortnite-serverreplay-downloader": "^1.0.8",
    "html2canvas": "^1.4.1",
    "next": "16.2.9",
    "playwright": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "main": "elektron/haupt.js"
}
