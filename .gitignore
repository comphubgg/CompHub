# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# ------------------------------------------------------------ CompHub
# Das gebaute Programm - 354 MB gehoeren nicht in die Versionsverwaltung.
/dist/
/elektron/dist/

# Rohe Replays: 17.510 Dateien, 476 MB, und sie aendern sich nie wieder.
# Was gebraucht wird, sind die ausgewerteten Sammeldateien - die bleiben.
/data/replays/**/*.json
!/data/replays/**/_aggregat.json

# Zwischenspeicher der Entwicklung - war einmal 5,5 GB gross.
/.next/dev/
/.next/cache/

# Zugangsdaten der Anmeldedienste - Geheimnisse gehoeren nicht ins Repository.
/data/dienst-zugaenge.json

# Der ganze Datenordner gehoert nicht ins Repository.
#
# Darin liegen Turnierkarten, Prognosen, Tierlists, Konten, der Epic-Zugang
# und die VIP-Schluessel. Vier Altdateien werden historisch schon verfolgt
# und bleiben es - eine Regel hier wirkt nur auf noch nicht verfolgte
# Dateien. Alles Neue bleibt auf dem Rechner.
/data/**
!/data/notes.json
!/data/players.json
!/data/streamers.json
!/data/tournamentLeaderboards.json
.env* 
.vercel-temp.env 

# Die Tunnel-Zugangsdaten fuer den Umzug auf einen zweiten Rechner.
# Wer sie hat, kann thecomphub.com auf seinen eigenen Rechner umleiten.
/tunnel-zugang
/*.log
