<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ein Replay vollstaendig auslesen: Spieler samt Positionen ueber das ganze
    Match, Zonen, Kill-Feed. Grundlage fuer die Replay-Seite (/admin/replay)
    und fuer genaue Solo Clutch Points (Reboots). Nutzt denselben Leser wie
    fortnite-replay-analysis, nur im vollen Lesemodus.

    Seit 26.11.2026 die Bibliothek FortniteReplayReader 3.2.0 von NuGet (Shiqan/FortniteReplayDecompressor) statt der
    Fassung 3.0.0 aus node_modules/fortnite-replay-analysis: behebt die Endlosschleife bei ueberlaufenden Buendeln (#74),
    die Drehung der Figur ab Build 41 (#76) und liefert je Treffer die Waffe (BatchedDamageCues.SourceWeapon). Unreal.Core,
    Unreal.Encryption, OozSharp und Microsoft.Extensions.Logging.Abstractions kommen als Abhaengigkeiten mit.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Nur Baugruppen mit "ReplayReader" im Namen durchsucht die Bibliothek nach Export-Gruppen - sonst fehlen Stein und Metall. -->
    <AssemblyName>ReplayVollReplayReader</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Der Leser laeuft mehrfach nebeneinander, je Kern einer: ein eigener Faden fuer die Speicherbereinigung bremst dann nur. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FortniteReplayReader" Version="3.2.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
